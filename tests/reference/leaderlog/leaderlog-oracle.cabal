cabal-version: 3.0
name: leaderlog-oracle
version: 1.0.0
build-type: Simple

executable jormanager-leaderlog-oracle
  main-is: Main.hs
  hs-source-dirs: .
  default-language: Haskell2010
  ghc-options: -O2 -Wall
  build-depends:
    base >= 4.18 && < 5,
    bytestring,
    non-integral == 1.0.0.0,
    cardano-ledger-core == 1.21.0.0,
    cardano-protocol == 0.1.0.0,
    cardano-crypto-class == 2.5.1.0,
    cardano-crypto-praos == 2.2.4.0
